# Template processado pelo entrypoint padrao da imagem nginx (envsubst) e
# gravado em /etc/nginx/conf.d/default.conf na subida do container. As
# variaveis ${APP_DOMAIN} / ${ADMIN_DOMAIN} / ${KDS_DOMAIN} / ${API_DOMAIN}
# vem do ambiente do servico "proxy" no docker-compose.prod.yml.

# --- Zonas de rate limiting ---
# "geral": trafego normal dos 3 frontends e da API.
# "auth": login/registro/recuperacao de senha, bem mais restrito (forca bruta).
limit_req_zone $binary_remote_addr zone=geral:10m rate=20r/s;
limit_req_zone $binary_remote_addr zone=auth:10m rate=5r/m;
limit_req_status 429;

# Necessario para o proxy de WebSocket repassar o Upgrade/Connection corretos.
map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

# --- Cache ---
proxy_cache_path /var/cache/nginx/static levels=1:2 keys_zone=static_cache:10m max_size=200m inactive=7d use_temp_path=off;
proxy_cache_path /var/cache/nginx/api levels=1:2 keys_zone=api_cache:10m max_size=100m inactive=10m use_temp_path=off;

gzip on;
gzip_vary on;
gzip_proxied any;
gzip_comp_level 6;
gzip_min_length 256;
gzip_types text/plain text/css text/xml application/javascript application/json application/xml image/svg+xml;

# --- HTTP: redireciona tudo para HTTPS, exceto o desafio ACME do Let's Encrypt ---
server {
    listen 8080 default_server;
    server_name ${APP_DOMAIN} ${ADMIN_DOMAIN} ${KDS_DOMAIN} ${API_DOMAIN} _;

    location /healthz {
        access_log off;
        return 200 "ok";
        add_header Content-Type text/plain;
    }

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

# --- Portal do Cliente ---
server {
    listen 8443 ssl;
    http2 on;
    server_name ${APP_DOMAIN};

    ssl_certificate     /etc/letsencrypt/live/${APP_DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${APP_DOMAIN}/privkey.pem;
    include /etc/nginx/snippets/ssl-params.conf;

    location /assets/ {
        proxy_cache static_cache;
        proxy_cache_valid 200 7d;
        add_header X-Cache-Status $upstream_cache_status always;
        proxy_pass http://frontend:8080;
        include /etc/nginx/snippets/proxy-headers.conf;
    }

    location / {
        limit_req zone=geral burst=40 nodelay;
        proxy_pass http://frontend:8080;
        include /etc/nginx/snippets/proxy-headers.conf;
    }
}

# --- Backoffice (Admin) ---
server {
    listen 8443 ssl;
    http2 on;
    server_name ${ADMIN_DOMAIN};

    ssl_certificate     /etc/letsencrypt/live/${ADMIN_DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${ADMIN_DOMAIN}/privkey.pem;
    include /etc/nginx/snippets/ssl-params.conf;

    location /assets/ {
        proxy_cache static_cache;
        proxy_cache_valid 200 7d;
        add_header X-Cache-Status $upstream_cache_status always;
        proxy_pass http://admin:8080;
        include /etc/nginx/snippets/proxy-headers.conf;
    }

    location / {
        limit_req zone=geral burst=40 nodelay;
        proxy_pass http://admin:8080;
        include /etc/nginx/snippets/proxy-headers.conf;
    }
}

# --- Painel da Cozinha (KDS) ---
server {
    listen 8443 ssl;
    http2 on;
    server_name ${KDS_DOMAIN};

    ssl_certificate     /etc/letsencrypt/live/${KDS_DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${KDS_DOMAIN}/privkey.pem;
    include /etc/nginx/snippets/ssl-params.conf;

    location /assets/ {
        proxy_cache static_cache;
        proxy_cache_valid 200 7d;
        add_header X-Cache-Status $upstream_cache_status always;
        proxy_pass http://kds:8080;
        include /etc/nginx/snippets/proxy-headers.conf;
    }

    location / {
        limit_req zone=geral burst=40 nodelay;
        proxy_pass http://kds:8080;
        include /etc/nginx/snippets/proxy-headers.conf;
    }
}

# --- API (FastAPI) ---
server {
    listen 8443 ssl;
    http2 on;
    server_name ${API_DOMAIN};

    ssl_certificate     /etc/letsencrypt/live/${API_DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${API_DOMAIN}/privkey.pem;
    include /etc/nginx/snippets/ssl-params.conf;

    client_max_body_size 10m;

    # WebSocket do painel da cozinha (RF011/RF012) — precisa de Upgrade/Connection
    # e timeout longo, a conexao fica aberta o turno inteiro.
    location /ws/ {
        proxy_pass http://api:8000;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_read_timeout 3600s;
        include /etc/nginx/snippets/proxy-headers.conf;
    }

    # Login/registro/recuperacao de senha: zona de rate limit bem mais restrita.
    location ~ ^/api/v1/auth/(login|registrar|esqueci-senha|redefinir-senha)$ {
        limit_req zone=auth burst=5 nodelay;
        proxy_pass http://api:8000;
        include /etc/nginx/snippets/proxy-headers.conf;
    }

    # Cardapio: GET publico e o mesmo pra todo mundo por alguns segundos,
    # cache curto absorve picos sem servir dado desatualizado por muito tempo.
    location /api/v1/cardapio {
        limit_req zone=geral burst=40 nodelay;
        proxy_cache api_cache;
        proxy_cache_valid 200 10s;
        proxy_cache_use_stale error timeout updating;
        add_header X-Cache-Status $upstream_cache_status always;
        proxy_pass http://api:8000;
        include /etc/nginx/snippets/proxy-headers.conf;
    }

    location / {
        limit_req zone=geral burst=40 nodelay;
        proxy_pass http://api:8000;
        include /etc/nginx/snippets/proxy-headers.conf;
    }
}
