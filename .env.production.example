# Copie para .env.production e preencha com valores reais antes do deploy.
# NUNCA commitar .env.production (ja esta no .gitignore junto com .env).

# PostgreSQL
POSTGRES_USER=zapfood
POSTGRES_PASSWORD=troque-esta-senha-em-producao
POSTGRES_DB=zapfood

DATABASE_URL=postgresql+asyncpg://zapfood:troque-esta-senha-em-producao@db:5432/zapfood
SYNC_DATABASE_URL=postgresql+psycopg2://zapfood:troque-esta-senha-em-producao@db:5432/zapfood

# Redis (rede interna do compose de producao, sem porta publicada)
REDIS_URL=redis://redis:6379/0

# RabbitMQ
RABBITMQ_USER=zapfood
RABBITMQ_PASSWORD=troque-esta-senha-em-producao
RABBITMQ_URL=amqp://zapfood:troque-esta-senha-em-producao@rabbitmq:5672/

# App
ENVIRONMENT=production
SECRET_KEY=gere-uma-chave-aleatoria-longa-aqui
PEPPER_SENHA=gere-outra-chave-aleatoria-longa-aqui
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=720
LOG_LEVEL=INFO

# Numero de workers do uvicorn (processos independentes) — ajuste pela CPU
# disponivel; regra pratica comum e (2 x nucleos) + 1.
API_WORKERS=4

# Pool de conexoes do banco (SQLAlchemy/asyncpg). Cada worker do uvicorn abre
# seu proprio pool, entao o total de conexoes no Postgres pode chegar a
# API_WORKERS x (DB_POOL_SIZE + DB_MAX_OVERFLOW) sob pico — confira o
# max_connections do Postgres antes de subir estes valores.
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT_SEGUNDOS=30
DB_POOL_RECYCLE_SEGUNDOS=1800
DB_ECHO=false

# Redis
REDIS_MAX_CONNECTIONS=20
REDIS_SOCKET_TIMEOUT_SEGUNDOS=5
REDIS_SOCKET_CONNECT_TIMEOUT_SEGUNDOS=5

# RabbitMQ
RABBITMQ_HEARTBEAT_SEGUNDOS=60
WORKER_PREFETCH_COUNT=10

# Dominios reais dos 3 frontends publicados, separados por virgula
CORS_ORIGINS=https://app.seudominio.com,https://admin.seudominio.com,https://cozinha.seudominio.com

# Dominios usados pelo proxy nginx (um vhost HTTPS por dominio) e pelo
# init-letsencrypt.sh para emitir os certificados. Cada um precisa ter um
# registro DNS (A/AAAA) apontando para o IP publico deste servidor.
APP_DOMAIN=app.seudominio.com
ADMIN_DOMAIN=admin.seudominio.com
KDS_DOMAIN=cozinha.seudominio.com
API_DOMAIN=api.seudominio.com
LETSENCRYPT_EMAIL=seu-email@seudominio.com

# E-mails transacionais (Resend)
RESEND_API_KEY=
RESEND_FROM_EMAIL=zapFood <naoresponda@seudominio.com>
FRONTEND_URL_FALLBACK=https://app.seudominio.com
EMAIL_VERIFICATION_EXPIRE_MINUTES=1440
PASSWORD_RESET_EXPIRE_MINUTES=60

# Portas publicadas no host so quando descomentadas no compose (debug local);
# em producao o proxy nginx e quem publica 80/443.
API_PORT=8001
FRONTEND_PORT=5174
ADMIN_PORT=5175
KDS_PORT=5176

# Build args dos frontends (URLs publicas da API, resolvidas pelo navegador do usuario)
VITE_API_URL=https://api.seudominio.com/api/v1
VITE_WS_URL=wss://api.seudominio.com/ws/kds

# Registry/tag das imagens. So importam pro deploy via CI (.github/workflows/deploy.yml),
# que faz "docker compose pull" em vez de buildar no servidor — deploy manual
# com infra/scripts/deploy.sh (--build) ignora esses dois e builda local.
IMAGE_REGISTRY=ghcr.io/francisco-duo/zapfood-sistema
IMAGE_TAG=latest
