# PostgreSQL
POSTGRES_USER=zapfood
POSTGRES_PASSWORD=zapfood_dev_password
POSTGRES_DB=zapfood
POSTGRES_HOST=db
POSTGRES_PORT=5432

DATABASE_URL=postgresql+asyncpg://zapfood:zapfood_dev_password@db:5432/zapfood
SYNC_DATABASE_URL=postgresql+psycopg2://zapfood:zapfood_dev_password@db:5432/zapfood

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0

# RabbitMQ
RABBITMQ_USER=zapfood
RABBITMQ_PASSWORD=zapfood_dev_password
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_URL=amqp://zapfood:zapfood_dev_password@rabbitmq:5672/

# App
SECRET_KEY=change-me-in-production
PEPPER_SENHA=change-me-in-production-pepper
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=720
ENVIRONMENT=development

# E-mails transacionais (Resend) — preencha RESEND_API_KEY com sua chave real.
RESEND_API_KEY=
RESEND_FROM_EMAIL=zapFood <onboarding@resend.dev>
FRONTEND_URL_FALLBACK=http://localhost:5174
EMAIL_VERIFICATION_EXPIRE_MINUTES=1440
PASSWORD_RESET_EXPIRE_MINUTES=60
